{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Propulsor",
  "version": "0.1.0",
  "identifier": "com.apro.propulsor",
  "build": {
    "beforeDevCommand": "npm --prefix ../../frontend run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../../frontend run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Propulsor — Liquid Engine Designer",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "APRO Works",
    "copyright": "© 2026 APRO Works. All rights reserved.",
    "category": "Education",
    "shortDescription": "Liquid rocket engine design tool",
    "longDescription": "Propulsor — end-to-end liquid rocket engine design and analysis: thermochemistry, nozzle contour, cooling, structures, injector, turbomachinery, feed system and control, with live inputs, 3D visualization, trade studies and CAD export.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"]
      }
    }
  }
}
